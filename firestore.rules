rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    function isClubMember(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    function clubRole(clubId) {
      return memberDoc(clubId).data.role;
    }

    function isClubAdmin(clubId) {
      return isClubMember(clubId) && clubRole(clubId) == 'clubAdmin';
    }

    // Set via the grantPlatformAdmin/devGrantPlatformAdmin callables (custom
    // claim), not a Firestore-backed role — see functions/src/callable.
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    // Denormalized onto the club doc by Cloud Functions whenever a license
    // is created/changed (trial creation, manual admin action, later Stripe
    // webhook) so this check never needs a scheduled "expire" job.
    function isClubLicenseActive(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId));
      return club.data.currentLicenseStatus == 'active' &&
        club.data.currentLicenseValidUntil > request.time;
    }

    // A fixture is a single top-level document (games/{gameId}), read by
    // whichever of the two involved clubs actually use LiveClub — never
    // nested under either club, so this checks membership in either side
    // rather than a single fixed clubId.
    function isGameParty(gameData) {
      return (gameData.get('homeClubId', null) != null && isClubMember(gameData.homeClubId)) ||
        (gameData.get('awayClubId', null) != null && isClubMember(gameData.awayClubId));
    }

    // Fields that are only ever written by Cloud Functions (Admin SDK),
    // never directly by a club member from the browser.
    function unchangedOrAbsent(field) {
      return !(field in request.resource.data) ||
        (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if isClubMember(clubId);
      // Club creation happens via a Cloud Function (adminSdk) so that
      // publicClubId + trial license + membership are created atomically.
      allow create: if false;
      allow update: if isClubAdmin(clubId) &&
        unchangedOrAbsent('publicClubId') &&
        unchangedOrAbsent('createdAt');
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isClubMember(clubId);
        // Memberships are created by Cloud Functions (club creation,
        // invitation acceptance). Club admins may remove a reporter.
        allow create: if false;
        allow update: if false;
        allow delete: if isClubAdmin(clubId) &&
          resource.data.role == 'reporter' &&
          memberId != request.auth.uid;
      }

      match /teams/{teamId} {
        allow read: if isClubMember(clubId);
        // Creation happens via the createTeam Cloud Function so the
        // publicTeamId can be generated collision-free (see createClub for
        // the same reasoning at the club level).
        allow create: if false;
        allow update, delete: if isClubAdmin(clubId);
      }

      match /licenses/{licenseId} {
        allow read: if isClubMember(clubId);
        // Licenses are only ever created/changed via Cloud Functions
        // (manual admin action today, Stripe webhook later).
        allow write: if false;
      }
    }

    // A fixture exists exactly once — top-level, not nested under either
    // club — so both the home and away club (when both use LiveClub) read
    // and administer the very same document. All writes go through Cloud
    // Functions (createGame, requestGameTransfer, acceptGameTransfer,
    // declineGameTransfer): computing eligibleEditorUids and validating a
    // transfer needs cross-club member reads a client-side rule can't do.
    match /games/{gameId} {
      allow get: if isGameParty(resource.data);
      // Provable per Firestore's query-constraint rule evaluation: the app
      // only ever queries this collection filtered by an exact
      // homeClubId/awayClubId equality match (two separate queries, not a
      // combined or()), so resource.data.homeClubId/awayClubId here is
      // exactly the query's own constraint value.
      allow list: if isGameParty(resource.data);
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isGameParty(get(/databases/$(database)/documents/games/$(gameId)).data);
        // Exactly one uid may ever administer a game at a time — this IS
        // the concurrency guard (see the 2026-08-15 editor-model design):
        // no separate locking primitive needed, since only the current
        // mainEditorUid ever passes this check.
        allow create: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.mainEditorUid &&
          request.resource.data.gameId == gameId &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.type in [
            'gameStarted', 'goalHome', 'goalAway', 'goalCorrection',
            'yellowCardHome', 'yellowCardAway', 'redCardHome', 'redCardAway',
            'halfTime', 'secondHalfStarted', 'gamePaused', 'gameResumed',
            'gameFinished', 'gameCancelled', 'manualCorrection'
          ] &&
          // A club with an expired/inactive license can no longer start a
          // new match; already-running games may still be played to a
          // finish so a lapse mid-game doesn't strand the reporter.
          (request.resource.data.type != 'gameStarted' ||
            isClubLicenseActive(get(/databases/$(database)/documents/games/$(gameId)).data.mainEditorClubId));
        // Events are immutable audit records; corrections are new events.
        allow update: if false;
        allow delete: if false;
      }

      match /editorHistory/{entryId} {
        allow read: if isGameParty(get(/databases/$(database)/documents/games/$(gameId)).data);
        allow write: if false;
      }
    }

    match /invitations/{invitationId} {
      // Fetching a single invitation by its (unguessable) id is how the
      // accept-invitation page previews it — including before the invited
      // person is signed in at all, so it can offer a "set your password"
      // form pre-filled with the invited email instead of the generic
      // registration page. Listing/querying the collection is restricted
      // to that club's admin, so a stranger can't enumerate pending
      // invites + email addresses by just knowing a clubId.
      allow get: if true;
      allow list: if isSignedIn() && isClubAdmin(resource.data.clubId);
      allow create: if isSignedIn() && isClubAdmin(request.resource.data.clubId);
      allow update: if false;
      allow delete: if isSignedIn() &&
        resource.data.status == 'pending' &&
        isClubAdmin(resource.data.clubId);
    }

    // Mirrored onto publicClubs/{id} by onClubWrite whenever a club's
    // license changes, so public reads can be gated without a scheduled
    // "expire" job — same trial/date-comparison model as isClubLicenseActive
    // above, just evaluated against the public mirror instead of the
    // private clubs/{clubId} doc.
    // Uses the map.get(key, default) safe-accessor form throughout — a
    // plain `clubDoc.data.licenseStatus` throws "Property ... is undefined"
    // during rule evaluation unless every possible document is statically
    // guaranteed to carry the field.
    //
    // Only gates `get` (single-document reads: direct club/team/game URLs,
    // the embed widget, TeamIcon lookups), never `list`. Firestore can't
    // prove a per-document, non-indexed condition true for every possible
    // match in an unfiltered collection query — it evaluates `list` rules
    // symbolically against the query itself, not against real documents, so
    // a `list` rule referencing resource.data here would deny the *entire*
    // homepage search the moment any club anywhere is expired, not just
    // hide that one club. The homepage instead filters expired/cancelled
    // clubs out client-side after an unrestricted list read (see page.tsx).
    function clubLicenseOk(clubDoc) {
      let validUntil = clubDoc.data.get('licenseValidUntil', null);
      return clubDoc.data.get('licenseStatus', null) == 'active' &&
        (validUntil == null || validUntil > request.time);
    }

    match /publicClubs/{publicClubId} {
      allow get: if clubLicenseOk(resource);
      allow list: if true;
      allow write: if false;

      match /teams/{teamId} {
        allow read: if clubLicenseOk(get(/databases/$(database)/documents/publicClubs/$(publicClubId)));
        allow write: if false;
      }
    }

    match /publicGames/{gameId} {
      allow get: if clubLicenseOk(
        get(/databases/$(database)/documents/publicClubs/$(resource.data.get('publicClubId', '')))
      );
      allow list: if true;
      allow write: if false;
    }

    // Short manual team announcements shown mixed into the same
    // chronological feed as games (see the 2026-08-21 "Team-Infos"
    // design) — public/anonymous read like publicGames above, since the
    // iOS/Android spectator apps have no login. Only ever written by
    // createTeamInfo (Admin SDK).
    match /teamInfos/{infoId} {
      allow get: if clubLicenseOk(
        get(/databases/$(database)/documents/publicClubs/$(resource.data.get('publicClubId', '')))
      );
      allow list: if true;
      allow write: if false;

      // Abuse-accountability audit log (infoId/teamId/editorId/sentAt/
      // termsVersion) — platform-admin-only concern for now, no client
      // role reads this today.
      match /pushLog/{logId} {
        allow read, write: if false;
      }
    }

    match /publicTeams/{publicTeamId} {
      allow get: if clubLicenseOk(
        get(/databases/$(database)/documents/publicClubs/$(resource.data.get('publicClubId', '')))
      );
      allow list: if true;
      allow write: if false;
    }

    // One doc per iOS/Android install (device id is a client-generated
    // UUID, no auth involved — same open-write trust model as the public
    // mirrors above). Lets the app register which teams it follows plus
    // its push tokens — iOS' ActivityKit push-to-start/update tokens, or
    // Android's single FCM registration token (`fcmToken`; unlike
    // ActivityKit, FCM doesn't need a separate token per running
    // activity, since a plain data push reaches the app either way) —
    // which onPublicGameWrite (functions/src/triggers) reads to drive
    // Live Activities/Live Updates. No client ever needs to read this
    // back, only write its own doc.
    match /deviceFollows/{deviceId} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['followedTeamIds', 'liveActivityDisabledTeamIds', 'pushNotificationsDisabledTeamIds', 'pushToStartToken', 'activityUpdateTokens', 'apnsAlertToken', 'fcmToken', 'platform', 'updatedAt']
        ) &&
        request.resource.data.platform is string &&
        (!('followedTeamIds' in request.resource.data) || (
          request.resource.data.followedTeamIds is list &&
          request.resource.data.followedTeamIds.size() <= 50
        )) &&
        // Per-team opt-out from automatic Live Activity starts (see the
        // "Live Activity immer starten" toggle) — the exception list, not a
        // mirror of every setting, so a device with everything enabled
        // (the common case) writes an empty/absent list here.
        (!('liveActivityDisabledTeamIds' in request.resource.data) || (
          request.resource.data.liveActivityDisabledTeamIds is list &&
          request.resource.data.liveActivityDisabledTeamIds.size() <= 50
        )) &&
        // Same exception-list shape, but for the "Push Notification" toggle
        // (Team-Info pushes) instead of Live Activity starts.
        (!('pushNotificationsDisabledTeamIds' in request.resource.data) || (
          request.resource.data.pushNotificationsDisabledTeamIds is list &&
          request.resource.data.pushNotificationsDisabledTeamIds.size() <= 50
        )) &&
        (!('pushToStartToken' in request.resource.data) ||
          request.resource.data.pushToStartToken is string) &&
        (!('activityUpdateTokens' in request.resource.data) ||
          request.resource.data.activityUpdateTokens is map) &&
        // Standard APNs alert token (Team-Info pushes, Phase 2) — distinct
        // from the ActivityKit-only tokens above.
        (!('apnsAlertToken' in request.resource.data) ||
          request.resource.data.apnsAlertToken is string) &&
        (!('fcmToken' in request.resource.data) ||
          request.resource.data.fcmToken is string);
      allow delete: if false;
    }

    // Site-wide branding (logo/icon/colors, light+dark) — the one settings
    // doc every visitor's browser needs to read (rendered on every public
    // page), unlike the rest of settings/* which stays admin-only. More
    // specific match wins over the generic settings/{docId} rule below.
    match /settings/branding {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // Any signed-in user needs to read the platform-wide Team-Info
    // defaults (infosPerDay/pushesPerDay/*Enabled) so the dashboard can
    // show/enforce the *actual* configured limit instead of a hardcoded
    // guess — not sensitive data, so this is safe to open up beyond
    // platformAdmin. Writes stay admin-only (falls through to the generic
    // settings/{docId} rule below). More specific match wins.
    match /settings/teamInfo {
      allow read: if isSignedIn();
    }

    // Platform-wide settings — nothing here is club-specific or public.
    match /settings/{docId} {
      allow read, write: if isPlatformAdmin();
    }

    // Transactional email templates (invite, club deactivated/deleted, and
    // any future ad-hoc ones added from /admin/mail-templates).
    match /emailTemplates/{templateId} {
      allow read, write: if isPlatformAdmin();
    }

    // "Tell us about a club we're missing" leads — write-only via the
    // submitClubRecommendation callable (Admin SDK, bypasses these rules
    // entirely), never directly from a client. Read is platform-admin only.
    match /clubRecommendations/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /supportRequests/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
  }
}
