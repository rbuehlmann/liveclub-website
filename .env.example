# Copy to .env.local. Values below are enough for local development against
# the Firebase Emulator Suite with the "demo-liveclub" project id — no real
# Firebase project needed yet. When a real project exists, replace these
# with the values from the Firebase console (Project settings > General >
# Your apps) and set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false.

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-liveclub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-liveclub
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-liveclub.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
