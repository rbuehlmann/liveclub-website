rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Cross-service firestore.get()/exists() calls from Storage rules proved
    // unreliable in production (a real clubAdmin with a correct Firestore
    // membership doc still got storage/unauthorized) — clubId/role are
    // mirrored onto the user's ID token as custom claims instead, kept in
    // sync by createClub/acceptInvitation/syncClubClaims (functions/src).
    function isClubAdmin(clubId) {
      return isSignedIn() &&
        request.auth.token.clubId == clubId &&
        request.auth.token.role == 'clubAdmin';
    }

    // Club logos: readable by anyone (used on public pages/widget),
    // only writable by the club's own admin.
    match /clubs/{clubId}/logo/{fileName} {
      allow read: if true;
      allow write: if isClubAdmin(clubId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
