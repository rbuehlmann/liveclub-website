# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.production only holds public Firebase client config (no secrets) and
# is needed at build time on the Infomaniak Node.js host, which deploys via
# `git clone` — there's no other way to get it onto the server.
!.env.production

# vercel
.vercel

# firebase emulators
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only Claude Code settings (per-machine tool permissions)
.claude/settings.local.json
